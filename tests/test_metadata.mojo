def test_flat_schema_and_chunk() raises:
    var m = parse_metadata(_valid())
    assert_equal(m.num_rows, 3)
    assert_equal(len(m.schema), 2)
    assert_equal(m.schema[0].parent, -1)
    assert_equal(m.schema[1].parent, 0)
    assert_true(m.schema[1].nullable())
    assert_true(m.schema[1].is_uint32())
    assert_equal(m.schema[1].max_definition_level, 1)
    assert_equal(m.schema[1].max_repetition_level, 0)
    assert_equal(m.row_groups[0].columns[0].schema_index, 1)
    assert_equal(m.row_groups[0].columns[0].codec, 0)
    assert_equal(m.row_groups[0].columns[0].encodings, [0, 3])
    assert_equal(m.row_groups[0].columns[0].path, [String("x")])
    validate_file_ranges(m, 36)
    with assert_raises():
        validate_file_ranges(m, 35)


def test_nested_schema_levels() raises:
    var m = parse_metadata(_nested())
    assert_equal(m.schema[2].parent, 1)
    assert_equal(m.schema[2].max_definition_level, 2)
    assert_equal(m.schema[2].max_repetition_level, 1)
    assert_equal(m.schema[2].path, [String("g"), "x"])
    assert_equal(m.row_groups[0].columns[0].num_values, 5)
    assert_equal(m.num_rows, 3)
    var limits = CompactLimits()
    limits.max_depth = 1
    with assert_raises():
        _ = parse_metadata(_nested(), limits)


def test_annotation_precedence_and_unknown() raises:
    var m = parse_metadata(_modern())
    assert_equal(m.schema[1].converted_type, 13)
    assert_equal(m.schema[1].logical_type, 10)
    assert_equal(m.schema[1].integer_width, 32)
    assert_true(m.schema[1].integer_signed)
    assert_false(m.schema[1].is_uint32())
    var future = parse_metadata(_unknown())
    assert_equal(future.schema[1].logical_type, 99)
    assert_equal(future.schema[1].physical_type, 1)
    assert_false(future.schema[1].is_uint32())


def test_invalid_schema_and_path() raises:
    with assert_raises():
        _ = parse_metadata(_missing_child())
    with assert_raises():
        _ = parse_metadata(_duplicate())
    with assert_raises():
        _ = parse_metadata(_wrong_path())


def test_range_overflow_and_external() raises:
    var m = parse_metadata(_oversized())
    with assert_raises():
        validate_file_ranges(m, 36)
    var external = parse_metadata(_valid())
    external.row_groups[0].columns[0].file_path = "part.parquet"
    with assert_raises():
        validate_file_ranges(external, 36)


def test_every_truncated_prefix() raises:
    var bytes = _valid()
    for n in range(len(bytes)):
        var prefix = List[UInt8]()
        for i in range(n):
            prefix.append(bytes[i])
        with assert_raises():
            _ = parse_metadata(prefix^)


def main() raises:
    TestSuite.discover_tests[__functions_in_module()]().run()
